generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum HighestEducationLevel {
  DIPLOMA
  BACHELOR
  MASTER
  PHD
}

enum FieldOfStudy {
  COMPUTER_SCIENCE
  MEDICINE
  ENGINEERING
  BUSINESS
  LAW
  PSYCHOLOGY
  OTHER
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  passwordHash          String
  fullName              String
  role                  Role
  highestEducationLevel HighestEducationLevel?
  fieldOfStudy          FieldOfStudy?
  nationality           String?
  gpa                   Float?
  dateOfBirth           DateTime               @db.Date
  graduationYear        Int?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  applications Application[]
  posts        Post[]
  comments     Comment[]
}

enum ProviderType {
  UNIVERSITY
  GOVERNMENT
  NGO
  FOUNDATION
}

model Provider {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  type         ProviderType
  country      String
  city         String?
  website      String?
  rankings     Json?

  scholarships Scholarship[]
}

enum DegreeLevel {
  DIPLOMA
  BACHELOR
  MASTER
  PHD
}

enum CoverageType {
  FULL
  PARTIAL
}

model Scholarship {
  id                       String         @id @default(uuid()) @db.Uuid
  title                    String
  description              String

  providerId               String         @db.Uuid
  provider                 Provider       @relation(fields: [providerId], references: [id])

  degreeLevel              DegreeLevel
  fields                   FieldOfStudy[]
  coverageType             CoverageType
  coveragePercent          Int?
  fundingDetails           Json?

  studyCountry             String
  opensAt                  DateTime
  deadline                 DateTime

  allowedNationalities     String[]
  languageRequirements     Json?
  otherRequirements        String[]
  requiredDocuments        Json?

  minGpa                   Float?
  maxAge                   Int?
  acceptsExpiredDocuments  Boolean        @default(false)

  applicationUrl           String
  sourceType               String
  sourceUrl                String

  status                   String         @default("active")
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  applications             Application[]
  posts                    Post[]
}

enum ApplicationStatus {
  INTERESTED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REJECTED
}

model Application {
  id            String            @id @default(uuid()) @db.Uuid
  userId        Int
  scholarshipId String            @db.Uuid

  user          User              @relation(fields: [userId], references: [id])
  scholarship   Scholarship       @relation(fields: [scholarshipId], references: [id])

  status        ApplicationStatus
  notes         String?
  submittedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, scholarshipId])
}

enum ContentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

model Post {
  id                String        @id @default(uuid())
  authorId          Int
  scholarshipId     String?       @db.Uuid
  title             String
  body              String
  status            ContentStatus @default(VISIBLE)
  acceptedCommentId String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  author          User          @relation(fields: [authorId], references: [id])
  scholarship     Scholarship?  @relation(fields: [scholarshipId], references: [id])
  comments        Comment[]     @relation("PostComments")
  acceptedComment Comment?      @relation("AcceptedComment", fields: [acceptedCommentId], references: [id])

  @@index([scholarshipId])
  @@index([authorId])
}

model Comment {
  id        String        @id @default(uuid())
  postId    String
  authorId  Int
  parentId  String?
  body      String
  status    ContentStatus @default(VISIBLE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  post           Post      @relation("PostComments", fields: [postId], references: [id])
  author         User      @relation(fields: [authorId], references: [id])
  parent         Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies        Comment[] @relation("CommentReplies")
  acceptedOnPost Post?     @relation("AcceptedComment")

  @@index([postId])
  @@index([parentId])
}

model Guide {
  id          String      @id @default(uuid())
  title       String
  portalName  String
  portalUrl   String
  description String

  steps       GuideStep[]
}

model GuideStep {
  id      String @id @default(uuid())
  guideId String
  order   Int
  title   String
  content String

  guide   Guide  @relation(fields: [guideId], references: [id])

  @@index([guideId])
}